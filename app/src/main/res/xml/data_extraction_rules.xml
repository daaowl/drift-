<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. No cloud backup; device-to-device transfer keeps favourites and settings, never the PIN. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="sukoon.db" />
        <exclude domain="file" path="datastore/sukoon_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
